# Cloudflare Tunnel URL (Admin/Internal API)
# Update this with your actual Cloudflare Tunnel public URL
CLOUDFLARE_TUNNEL_URL=https://issuer-v2.devlab.biz.id

# OID4VCI Endpoint (Required)
OID4VCI_ENDPOINT=https://issuer-api-v2.devlab.biz.id

# Public Endpoint (for Wallet Access)
# Set this if wallets need to access via different URL
OID4VCI_PUBLIC_ENDPOINT=https://issuer-api-v2.devlab.biz.id

